# The remote MCP server on its own: standard library only, nothing to install.
#   docker build -f Dockerfile.mcp -t sellable-mcp . && docker run -p 8765:8765 sellable-mcp
FROM python:3.12-slim

WORKDIR /app
COPY apps /app/apps
COPY mcp_server /app/mcp_server

ENV PYTHONUNBUFFERED=1 \
    SELLABLE_MCP_QUIET=1 \
    SELLABLE_SANDBOX_ROOT=/tmp/sellable-sandbox \
    PORT=8765
EXPOSE 8765

# Public sandbox by default. For a private server drop --sandbox and set SELLABLE_MCP_TOKEN.
CMD ["sh", "-c", "python -m mcp_server.server serve --http --sandbox --host 0.0.0.0 --port ${PORT}"]
