# SELLABLE — Environment
# Copy to .env and fill. Never commit .env.

# --- REQUIRED: Razorpay test-mode (https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx           # REQUIRED, SECRET — test key, safe to rotate
RAZORPAY_KEY_SECRET=your_secret_here        # REQUIRED, SECRET
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here  # REQUIRED, SECRET — HMAC for POST /webhook; empty => webhook fails closed (503)

# --- REQUIRED: Mission signing (custody) ---
MISSION_HMAC_KEY=generate_with_python_secrets_token_hex_32  # REQUIRED, SECRET — `python -c "import secrets; print(secrets.token_hex(32))"`
USER_MANDATE_KEY=generate_with_python_secrets_token_hex_32  # REQUIRED, SECRET — wallet key, NEVER held by buyer_agent (only scripts/mandate.py)

# --- REQUIRED: LLM / OpenRouter / Gemini ---
OPENROUTER_API_KEYS=your_openrouter_keys_comma_separated  # OPTIONAL — comma-separated pool for load balancing
GEMINI_API_KEY=your_gemini_api_key_here     # OPTIONAL, SECRET — Google AI Studio
GEMINI_MODEL=google/gemini-1.5-flash        # Canonical model
GEMINI_FALLBACK_MODELS=openai/gpt-4o-mini,meta-llama/llama-3.1-8b-instruct,anthropic/claude-3-haiku  # OPTIONAL — ordered fallback on 429/503/404

# --- OPTIONAL ---
PORT=8000                                   # OPTIONAL — server port; also SELLABLE_BASE_URL=http://localhost:8000
SELLABLE_BASE_URL=http://localhost:8000     # OPTIONAL — agent runner base URL (overrides PORT)
SELLABLE_DB_PATH=data/sellable.db           # OPTIONAL — SQLite path; tests use temp DB via SELLABLE_DB_PATH override

# --- REQUIRED: API key gating all mutating endpoints (F-08, Phase 3) ---
# REQUIRED to start the API in any real run; tests inject their own. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_API_KEY=sellable_demo_key_4f7e9c2a8b1d3e6f
