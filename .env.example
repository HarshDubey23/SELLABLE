# SELLABLE environment. Copy to .env and fill in what you have.
#
#   python run.py
#
# generates a working .env for you, so you normally do not need this file.
# Every value below is EMPTY on purpose: a placeholder that looks like a
# credential gets treated as one, and the app then claims to be live when
# it is not.

# --- Razorpay test mode (optional) -------------------------------------
# Leave empty to run on the simulated provider: no network calls, order
# ids prefixed order_sim_, and every surface labelled "simulated".
# Fill in to exercise the real api.razorpay.com test path.
# Keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# HMAC secret for POST /webhook. Empty => the webhook fails closed (503).
RAZORPAY_WEBHOOK_SECRET=

# --- Locally generated signing secrets (required) ----------------------
# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
# MISSION_HMAC_KEY signs missions (R9). Held by scripts/sign_mission.py.
MISSION_HMAC_KEY=
# USER_MANDATE_KEY signs the user's intent and cart mandates (INV-3).
# Held by scripts/mandate.py, standing in for the user's wallet.
USER_MANDATE_KEY=
# APP_API_KEY gates every mutating endpoint.
APP_API_KEY=

# --- LLM (optional) ----------------------------------------------------
# Without a key the buyer agent falls back to a deterministic picker.
# It holds no money authority either way.
OPENROUTER_API_KEY=
# Optional override. Defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=

# --- Local runtime (optional) ------------------------------------------
PORT=8000
SELLABLE_BASE_URL=http://127.0.0.1:8000
SELLABLE_DB_PATH=data/sellable.db
