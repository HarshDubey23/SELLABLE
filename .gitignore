# --- secrets ---------------------------------------------------------
.env

# --- python ----------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- runtime state ---------------------------------------------------
# The SQLite database and the signed mandates are produced by running the
# app. `data/.gitkeep` keeps the directory; nothing inside it is committed.
data/*
!data/.gitkeep
missions/*_mandate.json
*.log
*.err

# --- editors / os ----------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
node_modules/

# --- scratch -----------------------------------------------------------
# Ad-hoc probe scripts written while debugging. If one earns a place it
# becomes a test under tests/, which is the only directory pytest collects.
scratch/
live_demo.py
smoke_*.py
dbg_*.py
docs/generated/*.tmp

# --- delivery artifacts written into the working copy by tooling -------
# Not part of the project; a 13 MB git bundle in the repo root is noise.
*.bundle
PUSH*.bat
PUSH*.md
Claude outputs/
artifacts/
video_submission.txt

# --- personal recording notes, not part of the submission ---------------
# The demo script is written for whoever is holding the camera, not for a
# reviewer. Kept on disk, out of the repo.
docs/submission/DEMO_RECORDING_SCRIPT.docx
